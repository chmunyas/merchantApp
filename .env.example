# PesaSwap Payment SDK (Production)
# Get your keys from https://app.pesaswap.io
VITE_PESASWAP_PUBLISHABLE_KEY=pk_snd_your_publishable_key_here
VITE_BACKEND_URL=
PESASWAP_API_KEY=prd_your_secret_api_key_here
PESASWAP_WEBHOOK_SECRET=
PESASWAP_URL=https://app.Pesaswap.io

# Shared secret protecting the WhatsApp Baileys bridge (/send, /qr, /logout) when
# it is exposed publicly via a Cloudflare Tunnel so the deployed Worker can reach
# it. The same value must be set as the Worker secret WHATSAPP_BRIDGE_TOKEN.
# Generate one: `openssl rand -hex 32`  (or any long random string). Leave unset
# to keep the bridge internal-only (no public tunnel).
WHATSAPP_BRIDGE_TOKEN=
