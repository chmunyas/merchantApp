# PesaSwap Payment SDK (Production)
# Get your keys from https://app.pesaswap.io
VITE_PESASWAP_PUBLISHABLE_KEY=pk_snd_your_publishable_key_here
VITE_BACKEND_URL=
PESASWAP_API_KEY=prd_your_secret_api_key_here
PESASWAP_WEBHOOK_SECRET=
PESASWAP_URL=https://api.sandbox.pesaswap.io

# Shared secret protecting the WhatsApp Baileys bridge (/send, /qr, /logout) when
# it is exposed publicly via a Cloudflare Tunnel so the deployed Worker can reach
# it. The same value must be set as the Worker secret WHATSAPP_BRIDGE_TOKEN.
# Generate one: `openssl rand -hex 32`  (or any long random string). Leave unset
# to keep the bridge internal-only (no public tunnel).
WHATSAPP_BRIDGE_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Keep development-only behavior explicit. docker-compose.yml enables these for
# the dev service; production wrangler profiles force both off.
ALLOW_SIMULATORS=0
AUTH_OTP_DEBUG=0

# Required in production for signup and portal-credential OTP requests. The site
# key is public; the secret stays server-side. Portal OTP delivery additionally
# needs live Africa's Talking SMS or WhatsApp credentials.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# Shared secret guarding the cron sweeps (/api/invoicing/run, /api/sequences/run).
# The bridge presents it as x-cron-secret; unset => the sweeps require an operator
# login instead. Must match the Worker secret CRON_SECRET for the deployed app.
CRON_SECRET=
